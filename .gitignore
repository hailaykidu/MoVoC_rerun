env/
__pycache__/
.pytest_cache/
*.pyc

# nested standalone project (its own repo, pushed separately to hailaykidu/LLM-Probe)
LLM_Probe/

# large/unrelated leftover data not used by the MoVoC code (dictionaries, POS
# lexicons, an unrelated "cmae" model checkpoint) -- only the real gold
# morpheme set is part of this project
data/*
!data/ሃይላይ_ኪዱ_Tigriyna_Morphem.json
!data/geez_wordlist_hailay_annotated.txt
!data/Geez_Hailay_Morphem.json

# stray scratch files that ended up inside the movoc/ package directory
movoc/*.txt
movoc/*.docx
movoc/*.pdf
movoc/tig.py
movoc/ሃይላይ*.json

# 0-byte leftover stubs from the original broken scaffold
vocab/*_bpe.txt
vocab/tigrinya_morphemes.txt
results/*_segmented.txt

logs/
output.json
read.py

# mt_finetune/ -- downstream MT reproduction (see mt_finetune/README.md).
# Model weights, raw/copied corpora, and SLURM logs are large binaries or
# multi-hundred-MB text, regenerable via the scripts themselves -- not
# committed, matching the convention used by MoVoC_MT and EnTiMT.
mt_finetune/init_model*/
mt_finetune/mt_output*/
mt_finetune/data/
mt_finetune/data_am/
mt_finetune/data_gez/
mt_finetune/logs/
mt_finetune/*.out
mt_finetune/*.err
